---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import type { Project } from '../data/projects';
import caelumDashboard from '../assets/projects/caelum-dashboard.png';
import caelumKitchen from '../assets/projects/caelum-kitchen.png';
import yaviDesktop from '../assets/projects/yavi-desktop.png';
import yaviPhone from '../assets/projects/yavi-phone.png';
// Caelum shows the product itself: the online menu and a customer ordering on the phone.
import caelumMenuDesktop from '../assets/projects/caelum-menu-desktop.png';
import caelumOrderPhone from '../assets/projects/caelum-order-phone.png';
import yaviLandingDesktop from '../assets/projects/landing-yavi-desktop.png';
import yaviLandingMobile from '../assets/projects/landing-yavi-mobile.png';
import despachaoLandingDesktop from '../assets/projects/landing-despachao-desktop.png';
import despachaoLandingMobile from '../assets/projects/landing-despachao-mobile.png';
import calculatorsLandingDesktop from '../assets/projects/landing-calculators-desktop.png';
import calculatorsLandingMobile from '../assets/projects/landing-calculators-mobile.png';
import DespachaoScreens from './DespachaoScreens.astro';
import DataStage from './DataStage.astro';
import TradingStage from './TradingStage.astro';

interface Props { project: Project; lang: Lang; large?: boolean; view?: 'landing' | 'app' }
const { project, lang, large = false, view = 'landing' } = Astro.props;

const landings: Record<string, { desktop: ImageMetadata; mobile: ImageMetadata }> = {
  caelum: { desktop: caelumMenuDesktop, mobile: caelumOrderPhone },
  yavi: { desktop: yaviLandingDesktop, mobile: yaviLandingMobile },
  despachao: { desktop: despachaoLandingDesktop, mobile: despachaoLandingMobile },
  calculators: { desktop: calculatorsLandingDesktop, mobile: calculatorsLandingMobile },
};
const landing = view === 'landing' ? landings[project.id] : undefined;
const loading = large ? 'eager' : 'lazy';
// Card covers render at about a third of the page; previews at full sheet width.
const sizes = large ? '(max-width: 900px) 100vw, 1160px' : '(max-width: 900px) 100vw, (max-width: 1180px) 50vw, 420px';
const widths = large ? [800, 1200, 1600] : [480, 800, 1100];
const phoneWidths = large ? [300, 450, 600] : [160, 240, 320];
const phoneSizes = large ? '300px' : '(max-width: 900px) 30vw, 120px';
---
<div class:list={['cover', `cover--${project.id}`, { 'cover--large': large, 'cover--landing': landing, 'cover--app': view === 'app' }]}>
  <div class="cover__in">
    {landing ? (
      <>
        <div class="browser">
          <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <Image src={landing.desktop} alt="" widths={widths} sizes={sizes} format="webp" loading={loading} />
        </div>
        <div class="phone"><Image src={landing.mobile} alt="" widths={phoneWidths} sizes={phoneSizes} format="webp" loading={loading} /></div>
      </>
    ) : (
      <>
        {project.id === 'caelum' && (
          <>
            <div class="shot"><Image src={caelumDashboard} alt="" widths={widths} sizes={sizes} format="webp" loading={loading} /></div>
            <div class="shot shot--front"><Image src={caelumKitchen} alt="" widths={widths} sizes={sizes} format="webp" loading={loading} /></div>
          </>
        )}
        {project.id === 'yavi' && (
          <>
            <div class="shot"><Image src={yaviDesktop} alt="" widths={widths} sizes={sizes} format="webp" loading={loading} /></div>
            <div class="phone"><Image src={yaviPhone} alt="" widths={phoneWidths} sizes={phoneSizes} format="webp" loading={loading} /></div>
          </>
        )}
        {project.id === 'despachao' && <DespachaoScreens large={large} />}
        {project.id === 'prolibu' && <DataStage lang={lang} />}
        {project.id === 'trading' && <TradingStage lang={lang} />}
      </>
    )}
  </div>
</div>
