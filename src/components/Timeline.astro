---
import { useTranslations, type Lang } from '../i18n/ui';
import { entries } from '../data/timeline';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-CO' : 'en-US', { month: 'short', year: 'numeric' });
const label = (ym: string) => fmt.format(new Date(`${ym}-15`)).replace('.', '');
// Oldest first, so scrolling down walks forward in time.
const ordered = [...entries].sort((a, b) => a.from.localeCompare(b.from) || a.track.localeCompare(b.track));
---
<section class="journey" id="experience" data-journey>
  <div class="journey__intro" data-reveal>
    <h2>{t('timeline.title')}</h2>
    <p>{t('timeline.sub')}</p>
  </div>
  <div class="journey__grid">
  <div class="journey__aside" aria-hidden="true">
    <span class="journey__year" data-year>{ordered[0].from.slice(0, 4)}</span>
    <span class="journey__legend"><i class="k-work"></i>{t('timeline.work')} <i class="k-product"></i>{t('timeline.product')} <i class="k-study"></i>{t('timeline.study')}</span>
  </div>
  <div class="journey__track">
    <div class="journey__line" aria-hidden="true"><span class="journey__fill" data-fill><i class="journey__truck"></i></span></div>
    <ol class="journey__list">
      {ordered.map((e) => (
        <li class:list={['journey__item', `journey__item--${e.track}`]} data-reveal data-year={e.from.slice(0, 4)}>
          <span class="journey__dot" aria-hidden="true"></span>
          <div class="journey__body">
            <p class="journey__when">{label(e.from)} – {e.to ? label(e.to) : t('timeline.now')} · {t(`timeline.${e.track}` as const)}</p>
            <h3>{e.title}</h3>
            <p class="journey__role">{e.role[lang]}</p>
            <p class="journey__what">{e.what[lang]}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  </div>
</section>
