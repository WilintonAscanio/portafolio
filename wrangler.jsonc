// Static site on Cloudflare Workers: `npm run build`, then `npx wrangler deploy` uploads dist/.
// The Worker only answers /api/contact; every other path is a static file.
{
  "name": "portafolio",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  // www is served too; pages declare the bare domain as canonical.
  "routes": [
    { "pattern": "wilintonascanio.com", "custom_domain": true },
    { "pattern": "www.wilintonascanio.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Serves /en from en.html (build.format = 'file').
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Contact form: 5 messages per minute per IP. RESEND_API_KEY is a secret set in the dashboard.
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
